Verifies that custom tags, downloads, and build steps override standard web binary behavior.

-- input.config --
Type Web Binary
DownloadBaseUrl https://downloads.example.com/example/
Category app-misc
EbuildName example-bin
CustomDownloadUrl https://custom.download.example.com/${version}/example.tar.gz
CustomVersionSource echo "v1.2.3"
CustomBuildSteps touch built.txt
ProgramName example
Binary amd64=>example-${VERSION}.tar.gz > example

-- expected.yaml --
# Generated using: https://github.com/arran4/arrans_overlay_workflow_builder 1.0.0 Web Binary test.config 2026-07-12 00:00:00 +0000 UTC

name: app-misc/example-bin update

permissions:
  contents: write

on:
  schedule:
    - cron: '24 2 * * *'
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/app-misc-example-bin-update.yaml'

env:
  ecn: app-misc
  epn: example-bin
  description: ""
  homepage: ""
  keywords: ~amd64
  workflow_filename: app-misc-example-bin-update.yaml
  example_binary_installed_name: 'example'
  example_release_name_amd64: 'example-${version}.tar.gz'

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: false

jobs:
  check-and-create-ebuild:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Set up Git
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'

      - name: Install g2
        uses: arran4/g2-action@v1.2

      - name: Process each release
        id: process_releases
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p "$ebuild_dir"
          metadata_file="${ebuild_dir}/metadata.xml"
          g2 metadata -m "gentoo@arran4.com:Arran Ubels:person" "$metadata_file"
          declare -A releaseTypes=()
          emit_provenance_field() {
              local label=$1
              local value=$2
              local prefix="#   ${label}: "
              local continuation
              local width
              printf -v continuation '%*s' "${#prefix}" ''
              continuation="#${continuation:1}"
              while :; do
                  width=$((80 - ${#prefix}))
                  if ((${#value} <= width)); then
                      printf '%s%s\n' "$prefix" "$value"
                      break
                  fi
                  printf '%s%s\n' "$prefix" "${value:0:width}"
                  value="${value:width}"
                  prefix=$continuation
              done
          }
          emit_ebuild_assignment() {
              local name=$1
              local value=$2
              echo "${name}=\"\""
              local clean_value="${value//$'\r'/}"
              clean_value="${clean_value//$'\n'/ }"
              clean_value="${clean_value//$'\t'/ }"
              local current_chunk=""
              while [ -n "$clean_value" ]; do
                  local char="${clean_value:0:1}"
                  clean_value="${clean_value:1}"
                  local escaped_char="$char"
                  # DO NOT escape $. It ruins variable expansion during ebuild sourcing!
                  if [ "$char" = "\\" ] || [ "$char" = "\"" ]; then
                      escaped_char="\\$char"
                  fi
                  local test_len=$((${#name} + 4 + ${#current_chunk} + ${#escaped_char} + 1))
                  if [ $test_len -gt 80 ] && [ -n "$current_chunk" ]; then
                      echo "${name}+=\"${current_chunk}\""
                      current_chunk="$escaped_char"
                  else
                      current_chunk="${current_chunk}${escaped_char}"
                  fi
              done
              if [ -n "$current_chunk" ]; then
                  echo "${name}+=\"${current_chunk}\""
              fi
          }
          tags=$(echo "v1.2.3")
          # shellcheck disable=SC2086
          for tag in $tags; do
            version="${tag#v}"
            if echo "$tag" | grep -qE '^v?[0-9]'; then
                version="${tag#v}"
            elif [ "${version}" = "${tag}" ]; then
                echo "$version == $tag so there is no v removed skipping"
                continue
            fi
            # shellcheck disable=SC2034
            originalVersion="${version}"
            if ! echo "${version}" | grep -E '^([0-9]+)\.([0-9]+)(\.([0-9]+))?(-r[0-9]+)?((_)(alpha|beta|rc|p)[0-9]*)*$'; then
                echo "tag / $version doesn't match regexp; skipping"
                continue
            fi
            # shellcheck disable=SC2001
            releaseType="$(echo "${version}" | sed -n 's/^[^_]\+_\(alpha\|beta\|rc\|p[0-9]*\).*$/\1/p')"
            if [[ ! -v releaseTypes[${releaseType:=release}] ]]; then
                if [[ -v releaseTypes[release] ]]; then
                  echo "Already have a newer main release: ${releaseTypes[release]}"
                  continue
                fi
                releaseTypes[${releaseType:=release}]="${version}"
            else
                echo "Already have a newer ${releaseType:=release} release: ${releaseTypes[${releaseType:=release}]}"
                continue
            fi
            tmp_ebuild_file="${ebuild_dir}/${{ env.epn }}-${version}.ebuild.tmp"
            # Resolve download URLs once per external resource
            declare -A resolved_download_urls=()

              # shellcheck disable=SC2016
              {
                echo "# SPDX-License-Identifier: "
                emit_metadata_field() {
                    local label=$1
                    local value=$2
                    local prefix="${label}+=\""
                    local width
                    echo "${label}=\"\""
                    while [ -n "$value" ]; do
                        width=$((80 - ${#prefix} - 1))
                        if [ "${#value}" -le "$width" ]; then
                            printf '%s%s\"\n' "$prefix" "$value"
                            break
                        fi
                        local chunk="${value:0:width}"
                        local break_idx=$width
                        local last_space=-1
                        for ((i=width-1; i>=0; i--)); do
                            if [ "${chunk:i:1}" = " " ]; then
                                last_space=$i
                                break
                            fi
                        done
                        local last_open_var=-1
                        for ((i=width-1; i>=0; i--)); do
                            if [ "${chunk:i:2}" = "\${" ]; then
                                last_open_var=$i
                                break
                            fi
                        done
                        if [ "$last_open_var" != "-1" ]; then
                            local has_close=0
                            for ((i=last_open_var; i<width; i++)); do
                                if [ "${chunk:i:1}" = "}" ]; then
                                    has_close=1
                                    break
                                fi
                            done
                            if [ "$has_close" = "0" ]; then
                                break_idx=$last_open_var
                            fi
                        fi
                        if [ "$break_idx" = "$width" ] && [ "$last_space" != "-1" ] && [ "$last_space" -gt 0 ]; then
                            break_idx=$((last_space + 1))
                        fi
                        if [ "$break_idx" = "0" ]; then
                            local close_idx=-1
                            for ((i=0; i<${#value}; i++)); do
                                if [ "${value:i:1}" = "}" ]; then
                                    close_idx=$i
                                    break
                                fi
                            done
                            if [ "$close_idx" != "-1" ] && [ "$close_idx" -lt "${#value}" ]; then
                                break_idx=$((close_idx + 1))
                            else
                                break_idx=$width
                            fi
                        fi
                        printf '%s%s\"\n' "$prefix" "${value:0:break_idx}"
                        value="${value:break_idx}"
                    done
                }
                # Shell helper to wrap provenance fields at exactly 80 chars
                emit_provenance_field() {
                    local label=$1
                    local value=$2
                    local prefix="#   ${label}: "
                    local continuation
                    local width
                    printf -v continuation '%*s' "${#prefix}" ''
                    continuation="#${continuation:1}"
                    while :; do
                        width=$((80 - ${#prefix}))
                        if ((${#value} <= width)); then
                            printf '%s%s\n' "$prefix" "$value"
                            break
                        fi
                        printf '%s%s\n' "$prefix" "${value:0:width}"
                        value=${value:width}
                        prefix=$continuation
                    done
                }
                echo '# Generated via:'
                emit_provenance_field "repository" "${{ github.server_url }}/${{ github.repository }}"
                emit_provenance_field "commit" "${{ github.sha }}"
                emit_provenance_field "workflow" ".github/workflows/${{ env.workflow_filename }}"
                echo 'EAPI=8'
                emit_ebuild_assignment "DESCRIPTION" "${{ env.description }}"
                emit_ebuild_assignment "HOMEPAGE" "${{ env.homepage }}"
                src_uri_val=""
                src_uri_val+=" amd64? (  "
                src_uri_val+=" https://custom.download.example.com/${version}/example.tar.gz "
                src_uri_val+=" -> \${P}-example-\${PV}.tar.gz  )  "
                emit_metadata_field "SRC_URI" "$src_uri_val"
                emit_ebuild_assignment "LICENSE" "unknown"
                echo 'SLOT="0"'
                emit_ebuild_assignment "KEYWORDS" "${{ env.keywords }}"
                                iuse_val=""
                emit_ebuild_assignment "IUSE" "$iuse_val"
                echo ''
                ruse_val=""
                emit_ebuild_assignment "REQUIRED_USE" "$ruse_val"
                echo ''
                rdepend_val=""
                emit_ebuild_assignment "RDEPEND" "$rdepend_val"
                echo ''
                echo 'S="${WORKDIR}"'
                echo ''
                echo 'src_unpack() { :; }'
                echo ''
                echo 'src_install() {'
                echo '	exeinto /opt/bin'
                echo '	if use amd64; then'
                echo '		newexe '\\
                echo '			"${DISTDIR}/${P}-${{ env.example_release_name_amd64 }}" \'
                echo '			"${{ env.example_binary_installed_name }}" '\\
                echo '			|| die "Failed to install Binary"'
                echo '	fi'
                echo '}'
              } > "$tmp_ebuild_file"
              if next_version=$(g2 ebuild next-revision --inspect "$tmp_ebuild_file" "${ebuild_dir}" "${version}"); then
                  next_ebuild_file="${ebuild_dir}/${{ env.epn }}-${next_version}.ebuild"
                  echo "Content changed or new version for $version. Writing $next_ebuild_file"
                  mv "$tmp_ebuild_file" "$next_ebuild_file"
                  ebuild_file="$next_ebuild_file"
              else
                  echo "Matches existing ebuild. Skipping."
                  rm -f "$tmp_ebuild_file"
                  continue
              fi
              failed=0
              if ! g2 manifest upsert-from-url "https://custom.download.example.com/${version}/example.tar.gz" "${{ env.epn }}-${version}-example-${version}.tar.gz" "${ebuild_dir}/Manifest"; then failed=1; fi
              if [ "$failed" -eq 1 ]; then
                  echo "Failed to generate manifest for $tag. Skipping..."
                  rm -f "$ebuild_file"
                  continue
              fi
              touch built.txt
              echo "generated_tag=${tag}" >> $GITHUB_OUTPUT
          done

      - name: Deduplicate ebuilds
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          g2 ebuild deduplicate "${ebuild_dir}"

      - name: Lint output
        if: steps.process_releases.outputs.generated_tag
        uses: arran4/g2-action@v1.2
        with:
          mode: 'run'
          action: 'lint -disable-rule PG0802 . ${{ env.ecn }}/${{ env.epn }}'

      - name: Commit and push changes
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p profiles metadata
          if [ -f profiles/repo_name ]; then
            :
          else
            echo "::warning title=Missing profiles/repo_name::profiles/repo_name is missing. Skipping creation because explicit upsert is not enabled."
          fi
          if [ ! -f profiles/eapi ]; then
            echo "8" > profiles/eapi
          fi
          if [ ! -f metadata/layout.conf ]; then
            wget -qO - https://raw.githubusercontent.com/gentoo/gentoo/master/metadata/layout.conf > metadata/layout.conf || true
          fi
          if ! grep -q "^cache-formats" metadata/layout.conf; then
            echo "cache-formats = md5-dict" >> metadata/layout.conf
          else
            echo "::warning title=Layout.conf check::cache-formats is already defined in layout.conf, skipping generation."
          fi
          g2 cache generate "${{ env.ecn }}/${{ env.epn }}"
          git add "./${ebuild_dir}"
          if git commit -m "Add ebuilds for new ${{ env.epn }} releases tag ${generated_tag}"; then
            git pull --rebase &&
            git push
          fi || true
        if: steps.process_releases.outputs.generated_tag
