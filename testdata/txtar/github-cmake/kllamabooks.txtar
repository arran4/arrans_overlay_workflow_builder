This fixture evaluates the complete GitHub CMake workflow, including metadata upsert,
dependency discovery, ebuild generation, manifest creation, linting, and commit steps.

-- input.config --
Type Github Cmake Release
GithubProjectUrl https://github.com/arran4/kjules
Category app-misc
EbuildName kjules
Description A testing client
Homepage https://github.com/arran4/kjules
License MIT
-- expected.yaml --
# Generated using: https://github.com/arran4/arrans_overlay_workflow_builder 1.0.0 Github Cmake Release test.config 2026-07-12 00:00:00 +0000 UTC

name: app-misc/kjules update

permissions:
  contents: write

on:
  schedule:
    - cron: '24 2 * * *'
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/app-misc-kjules-update.yaml'

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
  ecn: app-misc
  epn: kjules
  description: "A testing client"
  homepage: "https://github.com/arran4/kjules"
  github_owner: arran4
  github_repo: kjules
  workflow_filename: app-misc-kjules-update.yaml

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: false

jobs:
  check-and-create-ebuild:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Set up Git
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'

      - name: Install required tools
        run: |
          sudo apt-get update
          sudo apt-get install -y wget jq coreutils curl

      - name: Install g2
        uses: arran4/g2-action@v1.2

      - name: Process each release
        id: process_releases
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p "$ebuild_dir"
          metadata_file="${ebuild_dir}/metadata.xml"
          g2 metadata -m "gentoo@arran4.com:Arran Ubels:person" -u "github:arran4/kjules" "$metadata_file"
          tags=$(gh api repos/${{ env.github_owner }}/${{ env.github_repo }}/releases --jq '.[]? | select(type=="object" and has("tag_name")) | .tag_name')
          for tag in $tags; do
            originalVersion="${tag#v}"
            # shellcheck disable=SC2034
            version="${tag#v}"
            # Semantic Version format check (skip invalid tags)
            if ! echo "$version" | egrep -q '^([0-9]+)\.([0-9]+)(\.([0-9]+))?(-r[0-9]+)?((_)(alpha|beta|rc|p)[0-9]*)*$'; then
              echo "$tag / $version doesn't match gentoo version regexp; skipping"
              continue
            fi
            tmp_ebuild_file="${ebuild_dir}/${{ env.epn }}-${version}.ebuild.tmp"
              cmake_content=$(curl -sL "https://raw.githubusercontent.com/${{ env.github_owner }}/${{ env.github_repo }}/${tag}/CMakeLists.txt")
              # shellcheck disable=SC2001
              qt6_components=$(echo "$cmake_content" | grep -i "find_package(Qt6" | tr '()' '  ' | sed 's/find_package  *Qt6//i' | tr -s ' ' '\n' | grep -ivE 'REQUIRED|COMPONENTS|CONFIG' | sort -u || true)
              # shellcheck disable=SC2001
              kf6_packages=$(echo "$cmake_content" | grep -i "find_package(KF6" | tr '()' '  ' | grep -iv COMPONENTS | awk '{print $2}' | grep -i "^KF6" | sed 's/KF6//i' | sort -u || true)
              # shellcheck disable=SC2001
              kf6_components=$(echo "$cmake_content" | grep -i "find_package(KF6" | grep -i COMPONENTS | tr '()' '  ' | sed 's/.*COMPONENTS//i' | tr -s ' ' '\n' | grep -ivE 'REQUIRED' | sort -u || true)
              DEPEND=""
              if [ -n "$qt6_components" ]; then
                # shellcheck disable=SC2001
                qt6_flags=$(echo "$qt6_components" | grep -ivE 'Test|Svg' | tr '\n' ',' | sed 's/,$//' | tr '[:upper:]' '[:lower:]')
                if [ -n "$qt6_flags" ]; then
                  DEPEND="$DEPEND dev-qt/qtbase:6[$qt6_flags]"
                else
                  DEPEND="$DEPEND dev-qt/qtbase:6"
                fi
                # Handling qt6 components that map to different Gentoo packages if needed
                if echo "$qt6_components" | grep -iq "Svg"; then DEPEND="$DEPEND dev-qt/qtsvg:6"; fi
              fi
              BDEPEND="virtual/pkgconfig kde-frameworks/extra-cmake-modules:0"
              if echo "$qt6_components" | grep -iq "Test"; then
                 BDEPEND="$BDEPEND dev-qt/qttools:6[linguist]"
              fi
              for pkg in $kf6_packages $kf6_components; do
                 # Basic mapping logic for KF6
                 mapped=$(echo "$pkg" | tr '[:upper:]' '[:lower:]')
                 DEPEND="$DEPEND kde-frameworks/k${mapped}:6"
              done
              {
                echo "# SPDX-License-Identifier: "
                emit_metadata_field() {
                    local label=$1
                    local value=$2
                    local prefix="${label}+=\""
                    local width
                    echo "${label}=\"\""
                    while [ -n "$value" ]; do
                        width=$((80 - ${#prefix} - 1))
                        if [ "${#value}" -le "$width" ]; then
                            printf '%s%s\"\n' "$prefix" "$value"
                            break
                        fi
                        local chunk="${value:0:width}"
                        local break_idx=$width
                        local last_space=-1
                        for ((i=$width-1; i>=0; i--)); do
                            if [ "${chunk:i:1}" = " " ]; then
                                last_space=$i
                                break
                            fi
                        done
                        local last_open_var=-1
                        for ((i=$width-1; i>=0; i--)); do
                            if [ "${chunk:i:2}" = "\${" ]; then
                                last_open_var=$i
                                break
                            fi
                        done
                        if [ "$last_open_var" != "-1" ]; then
                            local has_close=0
                            for ((i=last_open_var; i<width; i++)); do
                                if [ "${chunk:i:1}" = "}" ]; then
                                    has_close=1
                                    break
                                fi
                            done
                            if [ "$has_close" = "0" ]; then
                                break_idx=$last_open_var
                            fi
                        fi
                        if [ "$break_idx" = "$width" ] && [ "$last_space" != "-1" ] && [ "$last_space" -gt 0 ]; then
                            break_idx=$((last_space + 1))
                        fi
                        if [ "$break_idx" = "0" ]; then
                            local close_idx=-1
                            for ((i=0; i<${#value}; i++)); do
                                if [ "${value:i:1}" = "}" ]; then
                                    close_idx=$i
                                    break
                                fi
                            done
                            if [ "$close_idx" != "-1" ] && [ "$close_idx" -lt "${#value}" ]; then
                                break_idx=$((close_idx + 1))
                            else
                                break_idx=$width
                            fi
                        fi
                        printf '%s%s\"\n' "$prefix" "${value:0:break_idx}"
                        value="${value:break_idx}"
                    done
                }
                # Shell helper to wrap provenance fields at exactly 80 chars
                emit_provenance_field() {
                    local label=$1
                    local value=$2
                    local prefix="#   ${label}: "
                    local continuation
                    local width
                    printf -v continuation '%*s' "${#prefix}" ''
                    continuation="#${continuation:1}"
                    while :; do
                        width=$((80 - ${#prefix}))
                        if ((${#value} <= width)); then
                            printf '%s%s\n' "$prefix" "$value"
                            break
                        fi
                        printf '%s%s\n' "$prefix" "${value:0:width}"
                        value=${value:width}
                        prefix=$continuation
                    done
                }
                echo '# Generated via:'
                emit_provenance_field "repository" "${{ github.server_url }}/${{ github.repository }}"
                emit_provenance_field "commit" "${{ github.sha }}"
                emit_provenance_field "workflow" ".github/workflows/${{ env.workflow_filename }}"
                echo ""
                echo "EAPI=8"
                echo ""
                echo "inherit cmake xdg"
                echo ""
                emit_metadata_field "DESCRIPTION" "${{ env.description }}"
                emit_metadata_field "HOMEPAGE" "${{ env.homepage }}"
                src_uri_val="https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/archive/refs/tags/${tag}.tar.gz -> \${P}.tar.gz"
                emit_metadata_field "SRC_URI" "$src_uri_val"
                echo ""
                emit_metadata_field "LICENSE" "MIT"
                echo "SLOT=\"0\""
                emit_metadata_field "KEYWORDS" "~amd64"
                echo "IUSE=\"debug\""
                echo ""
                emit_metadata_field "DEPEND" "$DEPEND"
                rdepend_val="\${DEPEND}"
                emit_metadata_field "RDEPEND" "$rdepend_val"
                emit_metadata_field "BDEPEND" "$BDEPEND"
                echo ""
              } > "$tmp_ebuild_file"
              if next_version=$(g2 ebuild next-revision --inspect "$tmp_ebuild_file" "${ebuild_dir}" "${version}"); then
                  next_ebuild_file="${ebuild_dir}/${{ env.epn }}-${next_version}.ebuild"
                  echo "Content changed or new version for $version. Writing $next_ebuild_file"
                  mv "$tmp_ebuild_file" "$next_ebuild_file"
                  ebuild_file="$next_ebuild_file"
              else
                  echo "Matches existing ebuild. Skipping."
                  rm -f "$tmp_ebuild_file"
                  continue
              fi
              failed=0
              if ! g2 manifest upsert-from-url "https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/archive/refs/tags/${tag}.tar.gz" "${{ env.epn }}-${version}.tar.gz" "${ebuild_dir}/Manifest"; then failed=1; fi
              if [ "$failed" -eq 1 ]; then
                  echo "Failed to generate manifest for $tag. Skipping..."
                  rm -f "$ebuild_file"
                  continue
              fi
              echo "generated_tag=${tag}" >> $GITHUB_OUTPUT
          done

      - name: Deduplicate ebuilds
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          g2 ebuild deduplicate "${ebuild_dir}"

      - name: Lint output
        if: steps.process_releases.outputs.generated_tag
        uses: arran4/g2-action@v1.2
        with:
          mode: 'run'
          action: 'lint -disable-rule PG0802 . ${{ env.ecn }}/${{ env.epn }}'

      - name: Commit and push changes
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p profiles metadata
          if [ -f profiles/repo_name ]; then
            :
          else
            echo "::warning title=Missing profiles/repo_name::profiles/repo_name is missing. Skipping creation because explicit upsert is not enabled."
          fi
          if [ ! -f profiles/eapi ]; then
            echo "8" > profiles/eapi
          fi
          if [ ! -f metadata/layout.conf ]; then
            wget -qO - https://raw.githubusercontent.com/gentoo/gentoo/master/metadata/layout.conf > metadata/layout.conf || true
          fi
          if ! grep -q "^cache-formats" metadata/layout.conf; then
            echo "cache-formats = md5-dict" >> metadata/layout.conf
          else
            echo "::warning title=Layout.conf check::cache-formats is already defined in layout.conf, skipping generation."
          fi
          g2 cache generate "${{ env.ecn }}/${{ env.epn }}"
          git add "./${ebuild_dir}"
          if git commit -m "Add ebuilds for new ${{ env.epn }} releases tag ${generated_tag}"; then
            git pull --rebase &&
            git push
          fi || true
        if: steps.process_releases.outputs.generated_tag
