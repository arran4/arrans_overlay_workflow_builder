Test USE flag normalization, deduplication, and determinism
-- input.config --
Type Github Binary Release
GithubProjectUrl https://github.com/example/tool
EbuildName tool-bin
Category app-misc
Description Test tool for determinism
Homepage https://example.com/tool
License MIT
Workaround Programs as Alternatives => amd64:my-alt arm64:my_alt
IUse doc bash my_alt extra_opt
ProgramName tool
Binary amd64[+extra_flag]=>tool_${VERSION}_linux_amd64.tar.gz > tool > tool
Binary arm64=>tool_${VERSION}_linux_arm64.tar.gz > tool > tool
ProgramName my-alt
Binary amd64=>tool_alt_${VERSION}_linux_amd64.tar.gz > tool > tool
ProgramName my_alt
Binary arm64=>tool_alt_${VERSION}_linux_arm64.tar.gz > tool > tool
Document amd64=>tool_${VERSION}_linux_amd64.tar.gz > README.md > README.md
ManualPage amd64=>tool_${VERSION}_linux_amd64.tar.gz > tool.1 > tool.1
ShellCompletionScript amd64:bash=>tool_${VERSION}_linux_amd64.tar.gz > completions/bash > tool
-- expected.yaml --
# Generated using: https://github.com/arran4/arrans_overlay_workflow_builder 1.0.0 Github Binary Release test.config 2026-07-12 00:00:00 +0000 UTC

name: app-misc/tool-bin update

permissions:
  contents: write

on:
  schedule:
    - cron: '24 2 * * *'
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/app-misc-tool-bin-update.yaml'

env:
  ecn: app-misc
  epn: tool-bin
  description: "Test tool for determinism"
  homepage: "https://example.com/tool"
  github_owner: example
  github_repo: tool
  keywords: ~amd64 ~arm64
  workflow_filename: app-misc-tool-bin-update.yaml
  my-alt_binary_installed_name: 'tool'
  my-alt_binary_archived_name_amd64: 'tool'
  my-alt_release_name_amd64: 'tool_alt_${version}_linux_amd64.tar.gz'
  my_alt_binary_installed_name: 'tool'
  my_alt_binary_archived_name_arm64: 'tool'
  my_alt_release_name_arm64: 'tool_alt_${version}_linux_arm64.tar.gz'
  tool_binary_installed_name: 'tool'
  tool_binary_archived_name_amd64[+extra_flag]: 'tool'
  tool_release_name_amd64[+extra_flag]: 'tool_${version}_linux_amd64.tar.gz'
  tool_binary_archived_name_arm64: 'tool'
  tool_release_name_arm64: 'tool_${version}_linux_arm64.tar.gz'

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: false

jobs:
  check-and-create-ebuild:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Set up Git
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'

      - name: Install g2
        uses: arran4/g2-action@v1.2

      - name: Process each release
        id: process_releases
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p "$ebuild_dir"
          metadata_file="${ebuild_dir}/metadata.xml"
          g2 metadata -m "gentoo@arran4.com:Arran Ubels:person" -u "github:example/tool" --use-add "bash:Install bash completion" --use-add "doc:Install documentation" --use-add "extra_flag:Enable extra_flag" --use-add "extra_opt:Enable extra_opt" --use-add "man:Install manual pages" --use-add "my_alt:Install my-alt binary" "$metadata_file"
          declare -A releaseTypes=()
          tags=$(GH_TOKEN="${{secrets.GITHUB_TOKEN}}" gh api "repos/${{ env.github_owner }}/${{ env.github_repo }}/releases" --jq '.[]? | select(type=="object" and has("tag_name")) | .tag_name')
          # shellcheck disable=SC2086
          for tag in $tags; do
            version="${tag#v}"
            if [ "${version}" = "${tag}" ]; then
                echo "$version == $tag so there is no v removed skipping"
                continue
            fi
            # shellcheck disable=SC2034
            originalVersion="${version}"
            if ! echo "${version}" | grep -E '^([0-9]+)\.([0-9]+)(\.([0-9]+))?(-r[0-9]+)?((_)(alpha|beta|rc|p)[0-9]*)*$'; then
                echo "tag / $version doesn't match regexp; skipping"
                continue
            fi
            # shellcheck disable=SC2001
            releaseType="$(echo "${version}" | sed -n 's/^[^_]\+_\(alpha\|beta\|rc\|p[0-9]*\).*$/\1/p')"
            if [[ ! -v releaseTypes[${releaseType:=release}] ]]; then
                if [[ -v releaseTypes[release] ]]; then
                  echo "Already have a newer main release: ${releaseTypes[release]}"
                  continue
                fi
                releaseTypes[${releaseType:=release}]="${version}"
            else
                echo "Already have a newer ${releaseType:=release} release: ${releaseTypes[${releaseType:=release}]}"
                continue
            fi
            tmp_ebuild_file="${ebuild_dir}/${{ env.epn }}-${version}.ebuild.tmp"

              # shellcheck disable=SC2016
              {
                echo '# Generated via: ${{ github.server_url }}/${{ github.repository }}/blob/${{ github.sha }}/.github/workflows/${{ env.workflow_filename }}'
                echo 'EAPI=8'
                echo "DESCRIPTION=\"${{ env.description }}\""
                echo "HOMEPAGE=\"${{ env.homepage }}\""
                echo 'SRC_URI="'
                echo "	amd64? ( extra_flag? ( !my_alt? (  https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/\${PV} -> \${P}-tool_\${PV}_linux_amd64.tar.gz  )  )  )  "
                echo "	amd64? ( my_alt? (  https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/\${PV} -> \${P}-tool_alt_\${PV}_linux_amd64.tar.gz  )  )  "
                echo "	arm64? ( !my_alt? (  https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/\${PV} -> \${P}-tool_\${PV}_linux_arm64.tar.gz  )  )  "
                echo "	arm64? ( my_alt? (  https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/\${PV} -> \${P}-tool_alt_\${PV}_linux_arm64.tar.gz  )  )  "
                echo '"'
                echo 'LICENSE="MIT"'
                echo 'SLOT="0"'
                echo 'KEYWORDS="${{ env.keywords }}"'
                echo -n 'IUSE="'
                echo -n ' bash doc extra_flag extra_opt man my_alt'
                echo '"'
                echo ''
                echo -n 'REQUIRED_USE="'
                echo -n 'my_alt? ( || ( amd64  ) ) my_alt? ( || ( arm64  ) ) '
                echo '"'
                echo ''
                echo -n 'RDEPEND="'
                echo -n ''
                echo '"'
                echo ''
                echo 'S="${WORKDIR}"'
                echo ''
                echo 'src_unpack() {'
                echo '  if use amd64 && use extra_flag && ! use my_alt ; then'
                echo "    unpack \"\${DISTDIR}/\${P}-tool_\${PV}_linux_amd64.tar.gz\" || die \"Can't unpack archive file\""
                echo '  fi'
                echo '  if use amd64 && use my_alt; then'
                echo "    unpack \"\${DISTDIR}/\${P}-tool_alt_\${PV}_linux_amd64.tar.gz\" || die \"Can't unpack archive file\""
                echo '  fi'
                echo '  if use arm64 && ! use my_alt ; then'
                echo "    unpack \"\${DISTDIR}/\${P}-tool_\${PV}_linux_arm64.tar.gz\" || die \"Can't unpack archive file\""
                echo '  fi'
                echo '  if use arm64 && use my_alt; then'
                echo "    unpack \"\${DISTDIR}/\${P}-tool_alt_\${PV}_linux_arm64.tar.gz\" || die \"Can't unpack archive file\""
                echo '  fi'
                echo '}'
                echo ''
                echo 'src_install() {'
                echo '  exeinto /opt/bin'
                echo '  if use amd64 && use my_alt; then'
                echo '    newexe "${{ env.my-alt_binary_archived_name_amd64 }}" "${{ env.my-alt_binary_installed_name }}" || die "Failed to install Binary"'
                echo '  fi'
                echo '  if use arm64 && use my_alt; then'
                echo '    newexe "${{ env.my_alt_binary_archived_name_arm64 }}" "${{ env.my_alt_binary_installed_name }}" || die "Failed to install Binary"'
                echo '  fi'
                echo '  if use amd64 && use extra_flag && ! use my_alt ; then'
                echo '    newexe "${{ env.tool_binary_archived_name_amd64[+extra_flag] }}" "${{ env.tool_binary_installed_name }}" || die "Failed to install Binary"'
                echo '  fi'
                echo '  if use arm64 && ! use my_alt ; then'
                echo '    newexe "${{ env.tool_binary_archived_name_arm64 }}" "${{ env.tool_binary_installed_name }}" || die "Failed to install Binary"'
                echo '  fi'
                echo '  if use bash; then'
                echo '    insinto "/usr/share/bash-completion/completions"'
                echo '    if use amd64; then'
                echo '      newins "completions/bash" "tool" || die "Failed to bash completion file"'
                echo '    fi'
                echo '  fi'
                echo '  if use man; then'
                echo '    if use amd64; then'
                echo '      newman "tool.1" "tool.1" || die "Failed to install manual page tool.1"'
                echo '    fi'
                echo '  fi'
                echo '  if use doc; then'
                echo '    if use amd64; then'
                echo '      dodoc "README.md" || die "Failed to install document README.md"'
                echo '    fi'
                echo '  fi'
                echo '}'
              } > "$tmp_ebuild_file"
              if next_version=$(g2 ebuild next-revision --inspect "$tmp_ebuild_file" "${ebuild_dir}" "${version}"); then
                  next_ebuild_file="${ebuild_dir}/${{ env.epn }}-${next_version}.ebuild"
                  echo "Content changed or new version for $version. Writing $next_ebuild_file"
                  mv "$tmp_ebuild_file" "$next_ebuild_file"
                  ebuild_file="$next_ebuild_file"
              else
                  echo "Matches existing ebuild. Skipping."
                  rm -f "$tmp_ebuild_file"
                  continue
              fi
              failed=0
              if ! g2 manifest upsert-from-url "https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/${version}" "${{ env.epn }}-${version}-tool_${version}_linux_amd64.tar.gz" "${ebuild_dir}/Manifest"; then failed=1; fi
              if ! g2 manifest upsert-from-url "https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/${version}" "${{ env.epn }}-${version}-tool_alt_${version}_linux_amd64.tar.gz" "${ebuild_dir}/Manifest"; then failed=1; fi
              if ! g2 manifest upsert-from-url "https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/${version}" "${{ env.epn }}-${version}-tool_${version}_linux_arm64.tar.gz" "${ebuild_dir}/Manifest"; then failed=1; fi
              if ! g2 manifest upsert-from-url "https://github.com/${{ env.github_owner }}/${{ env.github_repo }}/releases/download/${tag}/${version}" "${{ env.epn }}-${version}-tool_alt_${version}_linux_arm64.tar.gz" "${ebuild_dir}/Manifest"; then failed=1; fi
              if [ "$failed" -eq 1 ]; then
                  echo "Failed to generate manifest for $tag. Skipping..."
                  rm -f "$ebuild_file"
                  continue
              fi
              echo "generated_tag=${tag}" >> $GITHUB_OUTPUT
          done

      - name: Deduplicate ebuilds
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          g2 ebuild deduplicate "${ebuild_dir}"

      - name: Lint output
        if: steps.process_releases.outputs.generated_tag
        uses: arran4/g2-action@v1.2
        with:
          mode: 'run'
          action: 'lint -disable-rule PG0802 . ${{ env.ecn }}/${{ env.epn }}'

      - name: Commit and push changes
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p profiles metadata
          if [ -f profiles/repo_name ]; then
            :
          else
            echo "::warning title=Missing profiles/repo_name::profiles/repo_name is missing. Skipping creation because explicit upsert is not enabled."
          fi
          if [ ! -f profiles/eapi ]; then
            echo "8" > profiles/eapi
          fi
          if [ ! -f metadata/layout.conf ]; then
            wget -qO - https://raw.githubusercontent.com/gentoo/gentoo/master/metadata/layout.conf > metadata/layout.conf || true
          fi
          if ! grep -q "^cache-formats" metadata/layout.conf; then
            echo "cache-formats = md5-dict" >> metadata/layout.conf
          else
            echo "::warning title=Layout.conf check::cache-formats is already defined in layout.conf, skipping generation."
          fi
          g2 cache generate "${{ env.ecn }}/${{ env.epn }}"
          git add "./${ebuild_dir}"
          if git commit -m "Add ebuilds for new ${{ env.epn }} releases tag ${generated_tag}"; then
            git pull --rebase &&
            git push
          fi || true
        if: steps.process_releases.outputs.generated_tag
