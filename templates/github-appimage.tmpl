# Generated by arrans_binary_overlay_builder
EAPI=8
DESCRIPTION="[[ .Description ]]"
HOMEPAGE="[[ .Homepage ]]"
LICENSE="[[ .License ]]"
SLOT="0"
KEYWORDS="[[ .MaskedKeywords ]]"
IUSE=""
DEPEND=""
RDEPEND="[[ range $i, $dep := .Dependencies ]][[ $dep ]] [[ end ]]"
S="${WORKDIR}"
RESTRICT="strip"
[[ if .HasDesktopFile ]]
inherit xdg-utils
[[ end ]]

SRC_URI="
[[ range $er := .ExternalResources ]]
  https://github.com/[[ $.GithubOwner ]]/[[ $.GithubRepo ]]/releases/download/[[ $.Tag ]]/[[ $er.ReleaseFilename | ebuildvardoublequoted ]]
[[ end ]]
"

src_unpack() {
[[ range $pname, $prog := .Programs ]]
  [[ range $keyword, $binary := $prog.Binary ]]
    cp "${DISTDIR}/[[ index $binary 0 | ebuildvardoublequoted ]]" "[[ $prog.InstalledFilename ]]" || die "Can't copy archive file"
    chmod a+x "[[ $prog.InstalledFilename ]]" || die "Can't chmod archive file"
  [[ end ]]
  [[ if $prog.HasDesktopFile ]]
    "./[[ $prog.InstalledFilename ]]" --appimage-extract "[[ $prog.DesktopFile ]]" || die "Failed to extract .desktop from appimage"
  [[ end ]]
  [[ range $icon := $prog.Icons ]]
    [[ if eq $icon "hicolor-apps" ]]
    "./[[ $prog.InstalledFilename ]]" --appimage-extract "usr/share/icons" || die "Failed to extract hicolor icons from app image"
    [[ else if eq $icon "pixmaps" ]]
    "./[[ $prog.InstalledFilename ]]" --appimage-extract "usr/share/pixmaps" || die "Failed to extract pixmaps icons from app image"
    [[ else if eq $icon "root" ]]
    "./[[ $prog.InstalledFilename ]]" --appimage-extract "*.png" || die "Failed to extract root icons from app image"
    [[ end ]]
  [[ end ]]
[[ end ]]
}

src_prepare() {
[[ if .HasDesktopFile ]]
[[ range $pname, $prog := .Programs ]]
[[ if $prog.HasDesktopFile ]]
  sed -i 's:^Exec=.*:Exec=/opt/bin/[[ $prog.InstalledFilename ]]:' "squashfs-root/[[ $prog.DesktopFile ]]"
[[ end ]]
[[ end ]]
[[ end ]]
[[ range $pname, $prog := .Programs ]]
[[ range $icon := $prog.Icons ]]
[[ if eq $icon "hicolor-apps" ]]
  find squashfs-root -type f \( -name index.theme -or -name icon-theme.cache \) -exec rm {} \;
  find squashfs-root -type d -exec rmdir -p --ignore-fail-on-non-empty {} \;
[[ end ]]
[[ end ]]
[[ end ]]
  eapply_user
}

src_install() {
    exeinto /opt/bin
[[ range $pname, $prog := .Programs ]]
    doexe "[[ $prog.InstalledFilename ]]" || die "Failed to install AppImage"
[[ end ]]
[[ if .HasDesktopFile ]]
    insinto /usr/share/applications
[[ range $pname, $prog := .Programs ]]
    doins "squashfs-root/[[ $prog.DesktopFile ]]" || die "Failed to install desktop file"
[[ end ]]
[[ end ]]
[[ range $pname, $prog := .Programs ]]
[[ range $icon := $prog.Icons ]]
[[ if eq $icon "hicolor-apps" ]]
    insinto /usr/share/icons
    doins -r squashfs-root/usr/share/icons/hicolor || die "Failed to install icons"
[[ else if eq $icon "pixmaps" ]]
    insinto /usr/share/pixmaps
    doins squashfs-root/usr/share/pixmaps/*.png || die "Failed to install icons"
[[ else if eq $icon "root" ]]
    insinto /usr/share/pixmaps
    doins squashfs-root/*.png || die "Failed to install icons"
[[ end ]]
[[ end ]]
[[ end ]]
}

[[ if .HasDesktopFile ]]
pkg_postinst() {
  xdg_desktop_database_update
}
[[ end ]]
