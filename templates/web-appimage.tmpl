# Generated using: https://github.com/arran4/arrans_overlay_workflow_builder [[.Version]] [[.Type]] [[.ConfigFile]] [[.Now]]

name: [[ .WorkflowName ]]

permissions:
  contents: write

on:
  schedule:
    - cron: '[[ .Cron ]]'
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/[[ .WorkflowFileName ]]'

env:
  ecn: [[ .Category ]]
  epn: [[ .PackageName ]]
  description: [[ .Description | quoteStr ]]
  homepage: [[ .Homepage  | quoteStr ]]
  keywords: [[ .MaskedKeywords ]]
  workflow_filename: [[ .WorkflowFileName ]]
  [[- range $pname, $prog := .Programs ]]
  [[- if $prog.HasDesktopFile ]]
  [[ join (filterEmpty $pname "desktop_file" ) "_" ]]: '[[ $prog.DesktopFile ]]'
  [[- end ]]
  [[ join (filterEmpty $pname "appimage_installed_name" ) "_" ]]: '[[ $prog.InstalledFilename ]]'
  [[- end ]]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: false

jobs:
  fetch-latest:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Set up Git
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'

      - name: Install required tools
        run: |
          sudo apt-get update
          sudo apt-get install -y wget jq coreutils
          [[- if and (not .DownloadRedirect) (not .GetDownloadPipeline) ]]
          curl -sfL https://github.com/mgdm/htmlq/releases/download/v0.4.0/htmlq-x86_64-linux.tar.gz | sudo tar xz -C /usr/local/bin htmlq
          [[- end ]]

      - name: Install g2
        uses: arran4/g2-action@v1.2

      - name: Determine latest AppImage
        id: find_appimage
        env:
          G2_PIPELINE_TMPL: "[[ if .GetDownloadPipeline ]][[ .GetDownloadPipeline | actionvardoublequoted ]][[ else ]]''[[ end ]]"
        run: |
          set -euo pipefail
          [[- if .GetDownloadPipeline ]]
          printf "%s" "[[ .PipelineScriptBase64 ]]" | base64 --decode > "$RUNNER_TEMP/g2-pipeline.py"
          [[- end ]]
          [[- if .PreVersionSteps ]]
          [[ .PreVersionSteps | actionvardoublequoted ]]
          [[- end ]]
          [[- if .CustomVersionSource ]]
          version=$([[ .CustomVersionSource | actionvardoublequoted ]])
          [[- end ]]
          [[- if .CustomDownloadUrl ]]
          appimage_url="[[ .CustomDownloadUrl | actionvardoublequoted ]]"
          [[- else if .DownloadRedirect ]]
          appimage_url="$(curl -sIL -o /dev/null -w '%{url_effective}' '[[ .DownloadRedirect ]]')"
[[- else if .GetDownloadPipeline ]]
          G2_PIPELINE="${G2_PIPELINE_TMPL}"
          [[- if stringsContains .GetDownloadPipeline "${RELEASE_FILENAME}" ]]
             [[- fail "RELEASE_FILENAME is not supported for Web AppImage pipeline generation" ]]
          [[- end ]]
          [[- if stringsContains .GetDownloadPipeline "${VERSION}" ]]
             [[- if .CustomVersionSource ]]
          G2_PIPELINE="${G2_PIPELINE//\${VERSION}/${version}}"
             [[- else ]]
             [[- fail "VERSION placeholder used in pipeline but no CustomVersionSource is configured" ]]
             [[- end ]]
          [[- end ]]
          [[- if stringsContains .GetDownloadPipeline "${TAG}" ]]
             [[- fail "TAG is not supported for Web AppImage pipeline generation before download discovery" ]]
          [[- end ]]
          source_url="$(python3 "$RUNNER_TEMP/g2-pipeline.py" "$G2_PIPELINE")"
          appimage_url="$(curl -sIL -o /dev/null -w '%{url_effective}' "$source_url")"
          [[- else ]]
          source_url="$(curl -sL '[[ .DownloadPageUrl ]]' | htmlq -a href 'a' | grep -iE '[[ if .DownloadMatch ]][[ .DownloadMatch ]][[ else ]]\.AppImage$[[ end ]]' | sort -V | tail -n1)"
          if [ -z "$source_url" ]; then
            echo "failed to find AppImage link" >&2
            exit 1
          fi
          appimage_url="$(curl -sIL -o /dev/null -w '%{url_effective}' "$source_url")"
          [[- end ]]
          if [ -z "$appimage_url" ]; then
            echo "failed to resolve AppImage redirect" >&2
            exit 1
          fi
          fname="$(basename "$appimage_url")"
          artifact_ext="${fname##*.}"
          if [ -z "$artifact_ext" ] || [ "$artifact_ext" = "$fname" ]; then
            echo "unable to determine artifact extension from $fname" >&2
            exit 1
          fi
          [[- if not .CustomVersionSource ]]
          base_name="${fname%.*}"
          version="${base_name##*-}"
          [[- end ]]
          echo "appimage_url=$appimage_url" >> "$GITHUB_ENV"
          echo "appimage_extension=$artifact_ext" >> "$GITHUB_ENV"
          echo "version=$version" >> "$GITHUB_ENV"

      - name: Update ebuild
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p "$ebuild_dir"
          metadata_file="${ebuild_dir}/metadata.xml"
          g2 metadata [[ .G2MetadataArgs ]] "$metadata_file"
          tmp_ebuild_file="${ebuild_dir}/${{ env.epn }}-${version}.ebuild.tmp"
            # shellcheck disable=SC2016
            {
              echo '# Generated via: https://github.com/arran4/arrans_overlay/blob/main/.github/workflows/${{ env.workflow_filename }}'
              echo 'EAPI=8'
              echo "DESCRIPTION=\"${{ env.description }}\""
              echo "HOMEPAGE=\"${{ env.homepage }}\""
              echo 'LICENSE="[[ .License ]]"'
              echo 'SLOT="0"'
              echo 'KEYWORDS="${{ env.keywords }}"'
              echo 'IUSE=""'
              echo 'DEPEND=""'
              echo 'RDEPEND="sys-fs/fuse:0[[range $i, $dep := .Dependencies]][[if eq $dep "sys-fs/fuse:0"]][[else]] [[$dep]][[end]][[end]]"'
              echo 'S="${WORKDIR}"'
              echo 'RESTRICT="strip"'
              echo "SRC_URI=\"${appimage_url} -> \\${P}.${appimage_extension}\""
[[ if .HasDesktopFile ]]
              echo ''
              echo 'inherit xdg-utils'
[[ end ]]
              echo ''
              echo 'src_install() {'
[[- if .EbuildInclude.src_install ]]
[[ getEbuildIncludes .EbuildInclude "src_install" | indent (repeat 4 " ") | shell_echo | indent (repeat 16 " ") ]]
[[- end ]]
              echo '  cp "${DISTDIR}/${P}.${appimage_extension}" "${P}.${appimage_extension}" || die "Failed to copy AppImage"'
              echo '  chmod a+x "${P}.${appimage_extension}" || die "Can'"'"'t chmod archive file"'
[[ range $pname, $prog := .Programs ]]
[[ if $prog.HasDesktopFile ]]
              echo '  "./${P}.${appimage_extension}" --appimage-extract "${{ env.[[ join (filterEmpty $pname "desktop_file" ) "_" ]] }}" || die "Failed to extract .desktop from appimage"'
[[ end ]]
[[ range $i, $icon := $prog.Icons ]]
[[ if eq $icon "hicolor-apps" ]]
              echo '  "./${P}.${appimage_extension}" --appimage-extract "usr/share/icons" || die "Failed to extract hicolor icons from app image"'
[[ else if eq $icon "pixmaps" ]]
              echo '  "./${P}.${appimage_extension}" --appimage-extract "usr/share/pixmaps" || die "Failed to extract pixmaps icons from app image"'
[[ else if eq $icon "root" ]]
              echo '  "./${P}.${appimage_extension}" --appimage-extract "*.png" || die "Failed to extract root icons from app image"'
[[ end ]]
[[ end ]]
[[ end ]]
              echo '  exeinto /opt/bin'
[[- range $sname, $starget := .Symlinks ]]
              echo "  dosym [[ $starget ]] [[ $sname ]]"
[[- end ]]
[[ range $pname, $prog := .Programs ]]
              echo '  newexe "${P}.${appimage_extension}" "${{ env.[[ join (filterEmpty $pname "appimage_installed_name" ) "_" ]] }}" || die "Failed to install AppImage"'
[[ end ]]
[[ if .HasDesktopFile ]]
              echo '  insinto /usr/share/applications'
[[ range $pname, $prog := .Programs ]]
              echo '  doins "squashfs-root/${{ env.[[ join (filterEmpty $pname "desktop_file" ) "_" ]] }}" || die "Failed to install desktop file"'
[[ end ]]
[[ end ]]
[[ range $pname, $prog := .Programs ]]
[[ range $i, $icon := $prog.Icons ]]
[[ if eq $icon "hicolor-apps" ]]
              echo '  insinto /usr/share/icons'
              echo '  doins -r squashfs-root/usr/share/icons/hicolor || die "Failed to install icons"'
[[ else if eq $icon "pixmaps" ]]
              echo '  insinto /usr/share/pixmaps'
              echo '  doins squashfs-root/usr/share/pixmaps/*.png || die "Failed to install icons"'
[[ else if eq $icon "root" ]]
              echo '  insinto /usr/share/pixmaps'
              echo '  doins squashfs-root/*.png || die "Failed to install icons"'
[[ end ]]
[[ end ]]
[[ end ]]
              echo '}'
[[- if or .HasDesktopFile .EbuildInclude.pkg_postinst ]]
              echo 'pkg_postinst() {'
[[- if .EbuildInclude.pkg_postinst ]]
[[ getEbuildIncludes .EbuildInclude "pkg_postinst" | indent (repeat 4 " ") | shell_echo | indent (repeat 16 " ") ]]
[[- end ]]
[[- if .HasDesktopFile ]]
              echo '  xdg_desktop_database_update'
[[- end ]]
              echo '}'
[[- end ]]
            } > "$tmp_ebuild_file"


[[- template "ebuild_revision_and_manifest" (dict "WorkaroundCheckAssetSize" $.WorkaroundCheckAssetSize "ExitOnMatch" true "ExternalResources" (list (dict "ReleaseFilename" (printf "${P}.%s" "${appimage_extension}"))) "DownloadBaseUrl" "$appimage_url" ) ]]

            g2 manifest upsert-from-url "$appimage_url" "${{ env.epn }}-${version}.${appimage_extension}" "${ebuild_dir}/Manifest"
[[ if .CustomBuildSteps ]]
            [[ .CustomBuildSteps ]]
[[ end ]]
            echo "generated_tag=${version}" >> $GITHUB_OUTPUT

      - name: Deduplicate ebuilds
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          g2 ebuild deduplicate "${ebuild_dir}"

[[- if .FeatureGenerateOverlay ]]
      - name: Generate Overlay
        run: |
          mkdir -p profiles metadata
          if [ ! -f profiles/repo_name ]; then
            repo_name="${GITHUB_REPOSITORY#*/}"
            repo_name="${repo_name//./_}"
            repo_name="${repo_name/#-/_}"
            echo "${repo_name}" > profiles/repo_name
          fi
          if [ ! -f profiles/eapi ]; then
            echo "8" > profiles/eapi
          fi
          if [ ! -f metadata/layout.conf ]; then
            wget -qO - https://raw.githubusercontent.com/gentoo/gentoo/master/metadata/layout.conf > metadata/layout.conf || true
          fi
          if ! grep -q "^cache-formats" metadata/layout.conf; then
            echo "cache-formats = md5-dict" >> metadata/layout.conf
          else
            echo "::warning title=Layout.conf check::cache-formats is already defined in layout.conf, skipping generation."
          fi
[[- end ]]

      - name: Lint output
        if: steps.find_appimage.outputs.version
        uses: arran4/g2-action@v1.2
        with:
          mode: 'run'
          action: 'lint [[ if not .FeatureGenerateMd5Cache ]]-disable-rule PG0802 [[ end ]]. ${{ env.ecn }}/${{ env.epn }}'

      - name: Commit and push changes
        run: |
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          mkdir -p profiles metadata
          if [ ! -f profiles/repo_name ]; then
            repo_name="${GITHUB_REPOSITORY#*/}"
            repo_name="${repo_name//./_}"
            repo_name="${repo_name/#-/_}"
            echo "${repo_name}" > profiles/repo_name
          fi
          if [ ! -f profiles/eapi ]; then
            echo "8" > profiles/eapi
          fi
          if [ ! -f metadata/layout.conf ]; then
            wget -qO - https://raw.githubusercontent.com/gentoo/gentoo/master/metadata/layout.conf > metadata/layout.conf || true
          fi
          if ! grep -q "^cache-formats" metadata/layout.conf; then
            echo "cache-formats = md5-dict" >> metadata/layout.conf
          else
            echo "::warning title=Layout.conf check::cache-formats is already defined in layout.conf, skipping generation."
          fi
          g2 cache generate "${{ env.ecn }}/${{ env.epn }}"
          git add "${ebuild_dir}"
          [[ if .FeatureGenerateMd5Cache ]]
          git add metadata/md5-cache/${{ env.ecn }}/${{ env.epn }}-* || true
          [[ end ]]
          if git commit -m "Add ebuild for version ${version}"; then
            git pull --rebase &&
            git push
          fi || true
        if: steps.find_appimage.outputs.version
[[ if .CustomJobSteps ]]
[[ indent "      " .CustomJobSteps ]]
[[ end ]]
