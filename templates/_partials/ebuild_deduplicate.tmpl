[[ define "ebuild_deduplicate" ]]
          ebuild_dir="./${{ env.ecn }}/${{ env.epn }}"
          backup_dir=$(mktemp -d)
          cp -a "${ebuild_dir}"/. "${backup_dir}"/

          dedup_err=$(mktemp)
          if g2 ebuild deduplicate "${ebuild_dir}" 2>"${dedup_err}"; then
            :
          else
            dedup_rc=$?
            cat "${dedup_err}" >&2
            cp -a "${backup_dir}"/. "${ebuild_dir}"/
            rm -rf "${backup_dir}" "${dedup_err}"
            exit "${dedup_rc}"
          fi
          cat "${dedup_err}" >&2

          skipped_cleanup=0
          if grep -q "skipped cleanup: directory contains uncertain ebuilds" "${dedup_err}"; then
            skipped_cleanup=1
          fi
          rm -f "${dedup_err}"

          pre_ebuild_count=$(find "${backup_dir}" -maxdepth 1 -name "*.ebuild" | wc -l)
          post_ebuild_count=$(find "${ebuild_dir}" -maxdepth 1 -name "*.ebuild" | wc -l)

          manifest_verify_err=$(mktemp)
          g2 manifest verify "${ebuild_dir}" 2>"${manifest_verify_err}" || true
          has_extra_dist=0
          if grep -q "EXTRA in manifest:" "${manifest_verify_err}"; then
            has_extra_dist=1
          fi
          cat "${manifest_verify_err}" >&2
          rm -f "${manifest_verify_err}"

          if [ "$has_extra_dist" -eq 1 ] && { [ "$skipped_cleanup" -eq 1 ] || [ "$pre_ebuild_count" -gt "$post_ebuild_count" ]; }; then
            cp -a "${backup_dir}"/. "${ebuild_dir}"/
            echo "::notice title=Deduplication deferred::Manifest cleanup was skipped because directory contains uncertain ebuilds; retaining older ebuilds to maintain Manifest consistency."
          fi
          rm -rf "${backup_dir}"
[[- end ]]
