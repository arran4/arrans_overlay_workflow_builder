[[ define "metadata" ]]
                emit_metadata_field() {
                    local label=$1
                    local value=$2
                    local prefix="${label}+=\""
                    local width

                    echo "${label}=\"\""
                    while [ -n "$value" ]; do
                        width=$((80 - ${#prefix} - 1)) # -1 for closing quote
                        if ((${#value} <= width)); then
                            printf '%s%s\"\n' "$prefix" "$value"
                            break
                        fi

                        # Find the last space within the width to break cleanly if possible
                        # If no space, just break at width. But wait, space inside might be needed.
                        # Wait, the issue says:
                        # "Use valid Bash/ebuild assignment or append syntax so physical source lines remain <=80 positions while the final evaluated metadata value remains exactly the intended value."

                        printf '%s%s\"\n' "$prefix" "${value:0:width}"
                        value="${value:width}"
                    done
                }
[[ end ]]
