[[ define "commit_and_push" ]]
          ecn="${{ env.ecn }}"
          epn="${{ env.epn }}"
          ebuild_dir="${ecn}/${epn}"

          if [ -e "./${ebuild_dir}" ] || [ -n "$(git ls-files -- "${ebuild_dir}")" ]; then
            git add -A -- "${ebuild_dir}"
          fi
          for cache_root in "metadata/md5-cache" "metadata/cache"; do
            cache_pathspec=":(glob)${cache_root}/${ecn}/${epn}-[0-9]*"
            if [ -n "$(git ls-files -- "${cache_pathspec}")" ] || compgen -G "${cache_root}/${ecn}/${epn}-[0-9]*" >/dev/null; then
              git add -A -- "${cache_pathspec}"
            fi
          done

          has_staged_changes=0
          if ! git diff --cached --quiet; then
            has_staged_changes=1
          fi

          dirty_status=$(git status --porcelain)
          if [ -n "${dirty_status}" ]; then
            unexpected_dirty=$(printf '%s\n' "${dirty_status}" | grep -Ev '^[MADRC] ' || true)
            if [ -n "${unexpected_dirty}" ]; then
              echo "Error: worktree has unexpected unstaged or untracked changes outside staged package scope:" >&2
              printf '%s\n' "${unexpected_dirty}" >&2
              exit 1
            fi
          fi

          if [ "${has_staged_changes}" -eq 0 ]; then
            echo "No package changes to commit or push."
            exit 0
          fi

          target_branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
          if [ -z "${target_branch}" ]; then
            echo "Error: HEAD is detached; cannot determine target branch for push." >&2
            exit 1
          fi

          local_base=$(git rev-parse HEAD)
          git commit -m "${commit_msg}"

          post_commit_status=$(git status --porcelain)
          if [ -n "${post_commit_status}" ]; then
            echo "Error: worktree is not clean after commit; refusing to rebase or push:" >&2
            printf '%s\n' "${post_commit_status}" >&2
            exit 1
          fi

          max_attempts="${G2_PUSH_RETRY_MAX_ATTEMPTS:-5}"
          base_sleep="${G2_PUSH_RETRY_BASE_SLEEP_SECS:-1}"
          attempt=1
          while [ "${attempt}" -le "${max_attempts}" ]; do
            push_log=$(mktemp)
            push_rc=0
            if git push origin "HEAD:${target_branch}" >"${push_log}" 2>&1; then
              cat "${push_log}"
              rm -f "${push_log}"
              exit 0
            else
              push_rc=$?
            fi
            cat "${push_log}" >&2

            is_transient_race=0
            if grep -Eqi '(fetch first|non-fast-forward|cannot lock ref|stale info)' "${push_log}" && \
               ! grep -Eqi '(permission .* denied|403|authentication failed|protected branch|gh006|gh013|rule violations|pre-receive hook declined)' "${push_log}"; then
              is_transient_race=1
            fi
            rm -f "${push_log}"

            if [ "${is_transient_race}" -ne 1 ]; then
              echo "Error: git push failed with non-retryable error (exit ${push_rc})." >&2
              exit "${push_rc}"
            fi

            if [ "${attempt}" -ge "${max_attempts}" ]; then
              echo "Error: failed to push package update after ${max_attempts} attempts due to concurrent remote updates." >&2
              exit 1
            fi

            sleep_secs=$(( attempt * base_sleep + (RANDOM % 2) ))
            echo "Push rejected due to concurrent update (attempt ${attempt}/${max_attempts}); retrying in ${sleep_secs}s..." >&2
            sleep "${sleep_secs}"

            git fetch origin "${target_branch}"

            if git merge-base --is-ancestor HEAD "origin/${target_branch}"; then
              echo "Remote ${target_branch} already contains local commit."
              exit 0
            fi

            remote_pkg_changes=$(git diff --name-only "${local_base}..origin/${target_branch}" -- \
              "${ebuild_dir}" \
              ":(glob)metadata/md5-cache/${ecn}/${epn}-[0-9]*" \
              ":(glob)metadata/cache/${ecn}/${epn}-[0-9]*")
            if [ -n "${remote_pkg_changes}" ]; then
              echo "Error: remote ${target_branch} updated ${ebuild_dir} concurrently; refusing to replay potentially stale package state:" >&2
              printf '%s\n' "${remote_pkg_changes}" >&2
              exit 1
            fi

            if ! git rebase "origin/${target_branch}"; then
              echo "Error: git rebase onto origin/${target_branch} failed; aborting rebase." >&2
              git rebase --abort 2>/dev/null || true
              exit 1
            fi

            local_base=$(git rev-parse "origin/${target_branch}")
            attempt=$(( attempt + 1 ))
          done
          exit 1
[[- end ]]
