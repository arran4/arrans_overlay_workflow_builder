[[ define "generate_md5_cache" ]]
          mkdir -p profiles metadata
          if [ -f profiles/repo_name ]; then
[[- if .HasOverlayRepoName ]]
            if [ "$(cat profiles/repo_name)" != "[[ .GetOverlayRepoName ]]" ]; then
              echo "::warning title=profiles/repo_name mismatch::Configured canonical overlay identity '[[ .GetOverlayRepoName ]]' does not match existing profiles/repo_name '$(cat profiles/repo_name)' - leaving existing file untouched."
            fi
[[- else ]]
            :
[[- end ]]
          else
[[- if not .FeatureUpsertOverlayRepoName ]]
            echo "::warning title=Missing profiles/repo_name::profiles/repo_name is missing. Skipping creation because explicit upsert is not enabled."
[[- else ]]
[[- if .HasOverlayRepoName ]]
            echo "[[ .GetOverlayRepoName ]]" > profiles/repo_name
[[- else ]]
            repo_name="${GITHUB_REPOSITORY#*/}"
            repo_name="${repo_name//./_}"
            repo_name="${repo_name/#-/_}"
            echo "${repo_name}" > profiles/repo_name
[[- end ]]
[[- end ]]
          fi
          if [ ! -f profiles/eapi ]; then
            echo "8" > profiles/eapi
          fi
          if [ ! -f metadata/layout.conf ]; then
            wget -qO - https://raw.githubusercontent.com/gentoo/gentoo/master/metadata/layout.conf > metadata/layout.conf || true
          fi
          if ! grep -q "^cache-formats" metadata/layout.conf; then
            echo "cache-formats = md5-dict" >> metadata/layout.conf
          else
            echo "::warning title=Layout.conf check::cache-formats is already defined in layout.conf, skipping generation."
          fi
          declared_masters=()
          masters_line=$(grep -E '^[ \t]*masters[ \t]*=' metadata/layout.conf 2>/dev/null || true)
          if [ -n "$masters_line" ]; then
            raw_masters="${masters_line#*=}"
            for m in $raw_masters; do
              [ -n "$m" ] && declared_masters+=("$m")
            done
          fi

          resolved_masters=()
          for m in "${declared_masters[@]}"; do
            mpath=""
            if [ -n "${G2_MASTER_REPOS:-}" ]; then
              IFS="," read -ra mappings <<< "$G2_MASTER_REPOS"
              for mapping in "${mappings[@]}"; do
                if [ "${mapping%%=*}" = "$m" ]; then
                  mpath="${mapping#*=}"
                  break
                fi
              done
            fi
            if [ -z "$mpath" ] && [ -d "/var/db/repos/$m" ]; then mpath="/var/db/repos/$m"; fi
            if [ -z "$mpath" ] && [ -n "${G2_MASTER_REPO_DIR:-}" ] && [ -d "${G2_MASTER_REPO_DIR}/$m" ]; then mpath="${G2_MASTER_REPO_DIR}/$m"; fi
            if [ -z "$mpath" ] && [ -d "../$m" ]; then mpath="../$m"; fi
            if [ -z "$mpath" ] && [ -d "${RUNNER_TEMP:-/tmp}/repos/$m" ]; then mpath="${RUNNER_TEMP:-/tmp}/repos/$m"; fi

            if [ -n "$mpath" ] && [ -d "$mpath" ]; then
              resolved_masters+=("$m=$mpath")
            fi
          done

          master_flags=()
          if [ -n "${PORTAGE_REPOS_CONF:-}" ] && [ -e "${PORTAGE_REPOS_CONF}" ]; then
            master_flags+=("-repos-conf=${PORTAGE_REPOS_CONF}")
          fi
          if [ "${#resolved_masters[@]}" -gt 0 ]; then
            master_arg=$(IFS=","; echo "${resolved_masters[*]}")
            master_flags+=("-master-repo=${master_arg}")
          fi

          if [ "${#master_flags[@]}" -gt 0 ]; then
            g2_cache_cmd=(g2 cache generate "${master_flags[@]}" "${{ env.ecn }}/${{ env.epn }}")
          else
            g2_cache_cmd=(g2 cache generate "${{ env.ecn }}/${{ env.epn }}")
          fi

          cache_snapshot_dir=$(mktemp -d)
          for cache_root in "metadata/md5-cache" "metadata/cache"; do
            cache_dir="${cache_root}/${{ env.ecn }}"
            if [ -d "${cache_dir}" ]; then
              mkdir -p "${cache_snapshot_dir}/${cache_root}"
              find "${cache_dir}" -maxdepth 1 -type f -name "${{ env.epn }}-[0-9]*" -exec cp -a {} "${cache_snapshot_dir}/${cache_root}"/ \;
            fi
          done

          prune_obsolete_package_cache() {
            for cache_root in "metadata/md5-cache" "metadata/cache"; do
              cache_dir="${cache_root}/${{ env.ecn }}"
              [ -d "${cache_dir}" ] || continue
              while IFS= read -r -d '' cache_file; do
                base_name=$(basename "${cache_file}")
                if [ ! -f "./${{ env.ecn }}/${{ env.epn }}/${base_name}.ebuild" ]; then
                  rm -f "${cache_file}"
                fi
              done < <(find "${cache_dir}" -maxdepth 1 -type f -name "${{ env.epn }}-[0-9]*" -print0)
              rmdir "${cache_dir}" 2>/dev/null || true
            done
          }

          restore_package_cache_snapshot() {
            for cache_root in "metadata/md5-cache" "metadata/cache"; do
              cache_dir="${cache_root}/${{ env.ecn }}"
              if [ -d "${cache_dir}" ]; then
                find "${cache_dir}" -maxdepth 1 -type f -name "${{ env.epn }}-[0-9]*" -delete
              fi
              if [ -d "${cache_snapshot_dir}/${cache_root}" ] && [ -n "$(ls -A "${cache_snapshot_dir}/${cache_root}")" ]; then
                mkdir -p "${cache_dir}"
                cp -a "${cache_snapshot_dir}/${cache_root}"/. "${cache_dir}"/
              fi
            done
            prune_obsolete_package_cache
          }

          cache_err_file=$(mktemp)
          if "${g2_cache_cmd[@]}" 2>"$cache_err_file"; then
            cat "$cache_err_file" >&2
            rm -f "$cache_err_file"
            prune_obsolete_package_cache
            rm -rf "${cache_snapshot_dir}"
          else
            gen_rc=$?
            cat "$cache_err_file" >&2
            if grep -q "unavailable masters permitted by CI policy" "$cache_err_file"; then
              rm -f "$cache_err_file"
              restore_package_cache_snapshot
              rm -rf "${cache_snapshot_dir}"
              echo "::notice title=md5-cache skipped::Authoritative md5-cache generation requires unavailable master repository context; skipping cache generation per CI policy."
            elif grep -q "canonical cache metadata requires Portage evaluation" "$cache_err_file" && ! command -v portageq >/dev/null 2>&1; then
              rm -f "$cache_err_file"
              restore_package_cache_snapshot
              rm -rf "${cache_snapshot_dir}"
              echo "::notice title=md5-cache skipped::Inherited eclasses require Portage evaluation which is unavailable on runner; skipping cache generation per CI policy."
            else
              rm -f "$cache_err_file"
              restore_package_cache_snapshot
              rm -rf "${cache_snapshot_dir}"
              exit "$gen_rc"
            fi
          fi
[[- end ]]
